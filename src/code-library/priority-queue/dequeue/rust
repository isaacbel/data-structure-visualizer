use std::collections::BinaryHeap;
use std::cmp::Reverse;
fn main(){
    let mut pq: BinaryHeap<(Reverse<i32>,i32)> = BinaryHeap::new();
    pq.push((Reverse(3),10));
    pq.push((Reverse(1),20));
    pq.push((Reverse(2),30));
    let (_,val)=pq.pop().unwrap();
    println!("val={}", val);  // 20 (priority 1 = min)
}