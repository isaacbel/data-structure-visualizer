#include <vector>
#include <iostream>
#include <stdexcept>

int popBack(std::vector<int>& v) {
    if (v.empty()) throw std::underflow_error("pop_back on empty vector");
    int last = v.back();
    v.pop_back();  // O(1)
    return last;
}

int main() {
    std::vector<int> v = {10, 20, 30};
    std::cout << popBack(v) << "
";  // 30
    std::cout << v.size() << "
";    // 2
}
