#include <vector>
#include <iostream>

int main() {
    std::vector<int> v;
    v.reserve(4);          // optional: pre-allocate to avoid reallocs

    v.push_back(10);       // O(1) amortized
    v.push_back(20);
    v.push_back(30);

    std::cout << "size="     << v.size()     << "
";
    std::cout << "capacity=" << v.capacity() << "
";
    for (int x : v) std::cout << x << " ";  // 10 20 30
}
