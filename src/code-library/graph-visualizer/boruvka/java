import java.util.*;

public class Graph {
    int V;
    List<List<int[]>> adj;
    public Graph(int v) {
        V = v;
        adj = new ArrayList<>();
        for(int i=0; i<v; i++) adj.add(new ArrayList<>());
    }
    public void addEdge(int u, int v, int w) { adj.get(u).add(new int[]{v, w}); }
}